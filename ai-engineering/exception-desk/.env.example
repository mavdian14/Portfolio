# exception-desk — copy to .env and fill in.
# Nothing here is required: the service runs end-to-end with LLM_PROVIDER=mock.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local (Homebrew/psql):   postgresql+asyncpg://exception_desk:exception_desk@localhost:5432/exception_desk
# Inside docker compose:   postgresql+asyncpg://exception_desk:exception_desk@db:5432/exception_desk
DATABASE_URL=postgresql+asyncpg://exception_desk:exception_desk@localhost:5432/exception_desk

# ---------------------------------------------------------------------------
# LLM provider — mock | anthropic | openai | ollama
# ---------------------------------------------------------------------------
# `mock` is deterministic, makes no network calls, and runs the real tool handlers.
# It is the default so that the test suite and CI never spend money.
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Local fallback via Ollama's OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# ---------------------------------------------------------------------------
# Pipeline behaviour
# ---------------------------------------------------------------------------
PROMPT_VERSION=v1
MAX_TOKENS_PER_RECORD=2048
MAX_TOOL_ROUNDS=4
REPAIR_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Guards the deployed demo. Change it before deploying; see README.
DEMO_API_KEY=change-me
